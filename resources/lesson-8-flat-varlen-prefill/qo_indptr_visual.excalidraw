    {
      "id": "code_text",
      "type": "text",
      "x": 110,
      "y": 516,
      "width": 1168,
      "height": 84,
      "text": "extend_lens = [4, 2, 3]\nqo_indptr  = cumsum([0] + extend_lens) = [0, 4, 6, 9]\nreq_i_q    = q[ qo_indptr[i] : qo_indptr[i + 1] ]",
      "originalText": "extend_lens = [4, 2, 3]\nqo_indptr  = cumsum([0] + extend_lens) = [0, 4, 6, 9]\nreq_i_q    = q[ qo_indptr[i] : qo_indptr[i + 1] ]",
