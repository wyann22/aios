    {
      "type": "text",
      "id": "sched_owns",
      "x": 870,
      "y": 254,
      "width": 480,
      "height": 60,
      "text": "•  list[_ReqState]  — per-req progress\n•  TableManager   — page_table + token_pool\n•  CacheManager   — KV page allocator",
      "originalText": "•  list[_ReqState]  — per-req progress\n•  TableManager   — page_table + token_pool\n•  CacheManager   — KV page allocator",
