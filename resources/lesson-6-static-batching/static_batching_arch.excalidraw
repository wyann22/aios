    {
      "type": "text",
      "id": "eng_code",
      "x": 1492,
      "y": 240,
      "width": 480,
      "height": 228,
      "text": "def run_batch(scheduled):\n    b = scheduled.batch    # (B, seq_len)\n    logits = model.forward(\n        b.input_ids,\n        paged_kv_cache=mha_kv_cache,\n        batch=b,           # ← batched paged attn\n    )\n    last = logits[:, -1, :]\n\n    # per-req sampling (mixed params)\n    return torch.stack([\n        s.sample(last[i:i+1])\n        for i, s in enumerate(scheduled.samplers)\n    ])",
      "originalText": "def run_batch(scheduled):\n    b = scheduled.batch    # (B, seq_len)\n    logits = model.forward(\n        b.input_ids,\n        paged_kv_cache=mha_kv_cache,\n        batch=b,           # ← batched paged attn\n    )\n    last = logits[:, -1, :]\n\n    # per-req sampling (mixed params)\n    return torch.stack([\n        s.sample(last[i:i+1])\n        for i, s in enumerate(scheduled.samplers)\n    ])",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
