    {
      "type": "text",
      "id": "sched_methods",
      "x": 870,
      "y": 360,
      "width": 480,
      "height": 130,
      "text": "•  init_requests()        alloc table_idx + KV pages\n•  iter_prefill_batches()  group by prompt length\n•  schedule_decode_batch() pack all active reqs\n•  process_batch_output()  write tok, alloc page, EOS\n•  finalize_results()      detok, free pages",
      "originalText": "•  init_requests()        alloc table_idx + KV pages\n•  iter_prefill_batches()  group by prompt length\n•  schedule_decode_batch() pack all active reqs\n•  process_batch_output()  write tok, alloc page, EOS\n•  finalize_results()      detok, free pages",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
