    {
      "type": "text",
      "id": "llm_code",
      "x": 232,
      "y": 240,
      "width": 480,
      "height": 228,
      "text": "ids = tokenize(prompts)\nsched.init_requests(ids, params)\n\n# 1. prefill (grouped by len)\nfor b in sched.iter_prefill_batches():\n    tok = engine.run_batch(b)\n    sched.process_batch_output(b, tok)\n\n# 2. decode loop\nwhile sched.has_active_reqs:\n    b = sched.schedule_decode_batch()\n    tok = engine.run_batch(b)\n    sched.process_batch_output(b, tok)\n\nreturn sched.finalize_results()",
      "originalText": "ids = tokenize(prompts)\nsched.init_requests(ids, params)\n\n# 1. prefill (grouped by len)\nfor b in sched.iter_prefill_batches():\n    tok = engine.run_batch(b)\n    sched.process_batch_output(b, tok)\n\n# 2. decode loop\nwhile sched.has_active_reqs:\n    b = sched.schedule_decode_batch()\n    tok = engine.run_batch(b)\n    sched.process_batch_output(b, tok)\n\nreturn sched.finalize_results()",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
