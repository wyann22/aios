    {
      "type": "text",
      "id": "llm_role",
      "x": 220,
      "y": 192,
      "width": 500,
      "height": 22,
      "text": "Orchestrator — owns the outer loop",
      "originalText": "Orchestrator — owns the outer loop",
      "fontSize": 14,
