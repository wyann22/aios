    {
      "type": "text",
      "id": "s2_code",
      "x": 140, "y": 1212,
      "width": 1040, "height": 180,
      "text": "def iter_prefill_batches(self):\n    buckets = defaultdict(list)\n    for i, st in enumerate(self._states):\n        L = st.input_ids.shape[0]\n        buckets[L].append(i)                 # ← bucket by prompt length\n\n    for L, idxs in buckets.items():\n        reqs    = [self._states[i].req for i in idxs]\n        samplers= [self._states[i].sampler for i in idxs]\n        batch   = _build_prefill_batch(reqs, L)   # (B, L) tensor\n        yield ScheduledBatch(batch, samplers, idxs)",
      "originalText": "def iter_prefill_batches(self):\n    buckets = defaultdict(list)\n    for i, st in enumerate(self._states):\n        L = st.input_ids.shape[0]\n        buckets[L].append(i)                 # ← bucket by prompt length\n\n    for L, idxs in buckets.items():\n        reqs    = [self._states[i].req for i in idxs]\n        samplers= [self._states[i].sampler for i in idxs]\n        batch   = _build_prefill_batch(reqs, L)   # (B, L) tensor\n        yield ScheduledBatch(batch, samplers, idxs)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 200102,
      "version": 1,
      "versionNonce": 200103,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.3
    },
