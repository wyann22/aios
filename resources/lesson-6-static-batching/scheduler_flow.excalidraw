    {
      "type": "text",
      "id": "s3_code",
      "x": 140, "y": 2202,
      "width": 1040, "height": 200,
      "text": "def schedule_decode_batch(self):\n    if not self._states:\n        return None                             # decode loop done\n\n    idxs     = list(range(len(self._states)))   # ← take ALL active\n    reqs     = [self._states[i].req for i in idxs]\n    samplers = [self._states[i].sampler for i in idxs]\n\n    # input_ids: last sampled tok from token_pool[table_idx, cached_len-1]\n    # out_loc:   next kv write slot in page_table[table_idx, cached_len]\n    batch    = _build_decode_batch(reqs)        # (B, 1) tensor\n    return ScheduledBatch(batch, samplers, idxs)",
      "originalText": "def schedule_decode_batch(self):\n    if not self._states:\n        return None                             # decode loop done\n\n    idxs     = list(range(len(self._states)))   # ← take ALL active\n    reqs     = [self._states[i].req for i in idxs]\n    samplers = [self._states[i].sampler for i in idxs]\n\n    # input_ids: last sampled tok from token_pool[table_idx, cached_len-1]\n    # out_loc:   next kv write slot in page_table[table_idx, cached_len]\n    batch    = _build_decode_batch(reqs)        # (B, 1) tensor\n    return ScheduledBatch(batch, samplers, idxs)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 300102,
      "version": 1,
      "versionNonce": 300103,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.3
    },
    {
      "type": "text",
      "id": "s4_header",
      "x": 120, "y": 2460,
      "width": 1600, "height": 36,
      "text": "③  Decode batch SHRINKS as reqs hit EOS  —  static batching never adds new reqs",
      "originalText": "③  Decode batch SHRINKS as reqs hit EOS  —  static batching never adds new reqs",
      "fontSize": 26,
