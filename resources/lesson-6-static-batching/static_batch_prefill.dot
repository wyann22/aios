digraph Lesson6Prefill {
    rankdir=TB;
    splines=ortho;
    nodesep=0.45;
    ranksep=0.6;
    fontname="Helvetica";
    fontsize=11;
    labelloc="t";
    label="Prefill Scheduling (group by prompt length)";

    node [shape=box style="rounded,filled" color="#455a64" fillcolor="#eceff1" fontname="Helvetica" fontsize=10];
    edge [color="#607d8b" arrowsize=0.8 fontname="Helvetica" fontsize=9];

    init [label="Scheduler.init_requests(...)\nwrite prompt to page_table/token_pool"];
    group [label="iter_prefill_batches()\nlength_to_indices"];
    g1 [label="Group#1: prompt_len=16\nreq0, req3"];
    g2 [label="Group#2: prompt_len=32\nreq1, req2"];
    run [label="Engine.run_batch(batch, input_ids)\nforward + sample first token"];
    update [label="process_batch_output(...)\nappend_host + allocate decode page\nset model_input for next decode"];

    req0 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="5"><B>Req0 page_table row</B></TD></TR>
        <TR><TD>12</TD><TD>18</TD><TD>22</TD><TD>25</TD><TD>...</TD></TR>
        </TABLE>
    >];
    req1 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="5"><B>Req1 page_table row</B></TD></TR>
        <TR><TD>5</TD><TD>8</TD><TD>10</TD><TD>14</TD><TD>...</TD></TR>
        </TABLE>
    >];

    out0 [label="Req0 out_loc=[...prompt pages...]\nall_locs=[...prompt pages...]"];
    out1 [label="Req1 out_loc=[...prompt pages...]\nall_locs=[...prompt pages...]"];
    kv [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="9"><B>MHAKVCache pages</B></TD></TR>
        <TR><TD>5</TD><TD>8</TD><TD>10</TD><TD>12</TD><TD>14</TD><TD>18</TD><TD>22</TD><TD>25</TD><TD>...</TD></TR>
        </TABLE>
    >];

    init -> group;
    group -> g1;
    group -> g2;
    g1 -> run [label="batch #1"];
    g2 -> run [label="batch #2"];
    run -> update;

    update -> req0 [label="write page_table"];
    update -> req1 [label="write page_table"];
    req0 -> out0;
    req1 -> out1;
    out0 -> kv [label="store_kv"];
    out1 -> kv [label="store_kv"];
}
