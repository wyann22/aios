digraph Lesson6StaticBatchArchitecture {
    rankdir=LR;
    splines=ortho;
    nodesep=0.5;
    ranksep=0.7;
    fontname="Helvetica";
    fontsize=11;
    labelloc="t";
    label="Lesson 6 Static Batching (Scheduler + Engine, mini-sglang style)";

    node [shape=box style="rounded,filled" color="#455a64" fillcolor="#eceff1" fontname="Helvetica" fontsize=10];
    edge [color="#607d8b" arrowsize=0.8 fontname="Helvetica" fontsize=9];

    llm [label="LLM._generate_static_batch_paged(...)\n(orchestrator)"];
    scheduler [label="Scheduler\ninit_requests / iter_prefill_batches\nschedule_decode_batch / process_output"];
    engine [label="Engine.run_batch(...)\nmodel.forward + per-req sampler"];
    cache [label="CacheManager\nallocate/free physical pages"];
    table [label="TableManager\nslot pool + page_table + token_pool"];
    req [label="Req State\n(table_idx, cached_len, device_len,\nmodel_input, generated_steps)"];
    batch [label="ScheduledBatch\nBatch(reqs, phase)\ninput_ids + state_indices"];
    model [label="Qwen3ForCausalLM\nQwen3Attention(reqs=...)"];
    pool [label="MHAKVCache\nphysical KV pages"];
    result [label="finalize_results()\ndecode + free pages/slots"];

    llm -> scheduler [label="dispatch static-batch path"];

    scheduler -> table [label="allocate/free req slots"];
    scheduler -> cache [label="allocate/free pages"];
    scheduler -> req [label="maintain per-req runtime state"];
    scheduler -> batch [label="build prefill/decode batch"];

    batch -> engine [label="run one batch"];
    engine -> model [label="forward(reqs=batch.reqs)"];
    model -> pool [label="store_kv + gather"];
    engine -> scheduler [label="next_tokens"];

    scheduler -> result [label="all reqs finished"];
    result -> llm [label="return List[dict]"];

    table -> req [style=dashed label="table_idx mapping"];
    req -> model [style=dashed label="block_table (compat path)"];
}
