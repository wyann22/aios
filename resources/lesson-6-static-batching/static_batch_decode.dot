digraph Lesson6Decode {
    rankdir=TB;
    splines=ortho;
    nodesep=0.45;
    ranksep=0.6;
    fontname="Helvetica";
    fontsize=11;
    labelloc="t";
    label="Decode Scheduling Loop (prefill done, active reqs batched)";

    node [shape=box style="rounded,filled" color="#455a64" fillcolor="#eceff1" fontname="Helvetica" fontsize=10];
    edge [color="#607d8b" arrowsize=0.8 fontname="Helvetica" fontsize=9];

    sched [label="while True:\nscheduled = schedule_decode_batch()\nif None: break"];
    run [label="Engine.run_batch(...)\ninput_ids = cat(model_input_i)\nshape=(B_active, 1)"];
    post [label="process_batch_output(...)\nupdate generated / model_input\nallocate one page for unfinished req"];
    done [label="finalize_results()\nfree page_table[row,:device_len]\nTableManager.free(table_idx)"];

    before0 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="7"><B>Req0 page_table row</B></TD></TR>
        <TR><TD>12</TD><TD>18</TD><TD>22</TD><TD>25</TD><TD>40</TD><TD>55</TD><TD>...</TD></TR>
        </TABLE>
    >];
    after0 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="8"><B>Req0 page_table row (after)</B></TD></TR>
        <TR><TD>12</TD><TD>18</TD><TD>22</TD><TD>25</TD><TD>40</TD><TD>55</TD><TD>70</TD><TD>...</TD></TR>
        </TABLE>
    >];

    before1 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="6"><B>Req1 page_table row</B></TD></TR>
        <TR><TD>5</TD><TD>8</TD><TD>10</TD><TD>14</TD><TD>31</TD><TD>...</TD></TR>
        </TABLE>
    >];
    after1 [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="7"><B>Req1 page_table row (after)</B></TD></TR>
        <TR><TD>5</TD><TD>8</TD><TD>10</TD><TD>14</TD><TD>31</TD><TD>46</TD><TD>...</TD></TR>
        </TABLE>
    >];

    map0 [label="Req0 out_loc=[70]\nall_locs=[12,18,22,25,40,55,70]"];
    map1 [label="Req1 out_loc=[46]\nall_locs=[5,8,10,14,31,46]"];
    free [label="free_pages -- on each decode allocate\nfree_pages ++ when req finishes"];

    sched -> run;
    run -> post;
    post -> sched [label="unfinished req exists"];
    sched -> done [label="no active req"];

    post -> before0;
    post -> before1;
    before0 -> after0 [label="append new page"];
    before1 -> after1 [label="append new page"];
    after0 -> map0 [label="attention store_kv"];
    after1 -> map1 [label="attention store_kv"];
    map0 -> free;
    map1 -> free;
}
